  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "Submission": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "report",
              "edit_request",
              "delete_request"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proposed_body": {
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "kind",
          "reason",
          "evidence"
        ]
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "object_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "action": {
            "type": "string",
            "enum": [
              "publish",
              "hide",
              "restore",
              "delete",
              "edit",
              "identity",
              "dismiss"
            ]
          },
          "body": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "signed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "object_id",
          "revision",
          "action",
          "reason"
        ]
      },
      "Policy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "school_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "published",
              "pending",
              "review"
            ]
          },
          "blocked_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "revision": {
            "type": "integer"
          }
        },
        "required": [
          "school_id",
          "kind",
          "mode",
          "blocked_terms",
          "revision"
        ]
      },
      "TaskSubmission": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "report",
              "edit_request",
              "delete_request",
              "review"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proposed_body": {
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "kind",
          "reason",
          "evidence"
        ]
      },
      "TaskView": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "school_id": {
            "type": "string"
          },
          "submission": {
            "$ref": "#/components/schemas/TaskSubmission"
          },
          "object_revision": {
            "type": "integer"
