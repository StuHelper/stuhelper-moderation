              "report",
              "edit_request",
              "delete_request",
              "review",
              "appeal"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proposed_body": {
            "type": "string"
          },
          "previous_task_id": {
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "kind",
          "reason",
          "evidence"
        ]
      },
      "TaskView": {
        "type": "object",
