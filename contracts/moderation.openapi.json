              "$ref": "#/components/schemas/BatchOutcome"
            }
          }
        },
        "required": [
          "preview_token",
          "items"
        ]
      },
      "FeedbackAttachment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "content_type": {
            "type": "string",
            "maxLength": 256
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "stored",
              "rejected"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "content_type",
          "size",
          "status"
        ]
      },
      "FeedbackReply": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256
          },
          "body": {
            "type": "string",
            "maxLength": 20000
          },
          "actor": {
            "type": "string",
            "maxLength": 256
          },
          "state": {
            "type": "string",
            "enum": [
              "sending",
              "sent",
              "failed",
              "unknown"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
