        "properties": {
          "body": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "body"
        ]
      },
      "FeedbackPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Feedback"
            }
          },
          "next_cursor": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": [
          "items",
          "next_cursor"
        ]
      }
    }
  }
}
