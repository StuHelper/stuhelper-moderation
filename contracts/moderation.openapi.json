            "$ref": "#/components/schemas/TaskSubmission"
          },
          "object_revision": {
            "type": "integer"
          },
          "revision": {
            "type": "integer"
          },
          "state": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "error_code": {
            "type": "string"
          },
