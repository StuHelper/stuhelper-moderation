          "body",
          "actor",
          "state",
          "created_at"
        ]
      },
      "Feedback": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256
          },
          "sender": {
            "type": "string",
            "maxLength": 320
          },
          "subject": {
            "type": "string",
            "maxLength": 500
          },
          "body": {
            "type": "string",
            "maxLength": 200000
          },
          "authentication_results": {
            "type": "string",
            "maxLength": 4096
          },
          "suspicious": {
            "type": "boolean"
          },
          "state": {
            "type": "string",
            "enum": [
              "new",
              "processing",
              "resolved",
              "spam"
            ]
          },
          "assignee": {
            "type": "string",
            "maxLength": 256
          },
          "note": {
            "type": "string",
            "maxLength": 10000
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "closed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedbackAttachment"
            }
          },
          "replies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedbackReply"
            }
          }
        },
        "required": [
          "id",
          "sender",
          "subject",
          "body",
          "authentication_results",
          "suspicious",
          "state",
          "assignee",
          "note",
          "revision",
          "received_at",
          "closed_at",
          "attachments",
          "replies"
        ]
      },
      "FeedbackUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "new",
              "processing",
              "resolved",
              "spam"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 10000
          }
        },
        "required": [
