  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "Submission": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "report",
              "edit_request",
              "delete_request",
              "review"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proposed_body": {
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "kind",
          "reason",
          "evidence"
        ],
        "description": "Reports and author requests require an authenticated user; review tasks may only be opened by a moderator in the object school."
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "object_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "action": {
            "type": "string",
            "enum": [
              "publish",
              "hide",
              "restore",
              "delete",
              "edit",
              "identity",
              "dismiss",
              "feature",
              "unfeature",
              "reassign"
            ]
          },
          "body": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "signed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "author_handle": {
            "type": "string",
            "maxLength": 128,
            "description": "Discussion-local public author handle, used instead of a private account ID for identity moderation."
          },
          "teacher_id": {
            "type": "string"
          },
          "evidence_revision": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "object_id",
          "revision",
          "action",
          "reason"
        ]
      },
      "Policy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "school_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "published",
              "pending",
              "review"
            ]
          },
          "blocked_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "revision": {
            "type": "integer"
          }
        },
        "required": [
