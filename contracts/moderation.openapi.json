          "revision": {
            "type": "integer"
          },
          "state": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "error_code": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "school_id",
          "submission",
          "object_revision",
          "revision",
          "state",
          "created_at",
          "updated_at"
        ]
      },
      "Decide": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
