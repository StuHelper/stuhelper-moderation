            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "state",
          "code"
        ]
      },
      "BatchPreview": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "preview_token": {
            "type": "string"
          },
          "items": {
            "type": "array",
